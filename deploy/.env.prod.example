# Production configuration. Copy to deploy/.env.prod (never commit it) and fill in.
# Every setting is documented in backend/.env.example; this file lists what production needs.

# --- Public addresses ---
API_DOMAIN=api.example.com                 # DNS A record -> this VM; Caddy gets the certificate
ACME_EMAIL=you@example.com                 # Let's Encrypt expiry notices
CORS_ORIGINS=https://app.example.com       # the Vercel frontend, exact origin

# --- App ---
APP_ENV=production
LOG_FORMAT=json
# Prometheus scraping of http://api:8000/metrics from inside the Docker network. Leave empty
# to disable the endpoint. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Postgres (Neon): connection string with the psycopg driver and TLS ---
# postgresql+psycopg://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Qdrant Cloud ---
QDRANT_URL=https://xxxx.region.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks_v2

# --- Redis (runs on this VM, see compose.prod.yml) ---
REDIS_URL=redis://redis:6379/0
INGEST_MODE=queue

# --- Hosted LLM (OpenAI-compatible) ---
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Optional, for describing uploaded images (OCR text is used either way):
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Models (small, CPU-friendly) ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8

# --- Security gateway ---
SECURITY_ENABLED=true
SECURITY_CLASSIFIER_ENABLED=true

# --- Payments: Razorpay TEST MODE only (leave empty to disable) ---
# Test keys only (rzp_test_...); live keys and PAYMENTS_TEST_MODE=false are refused at startup.
# Webhook URL in the Razorpay dashboard: https://<API_DOMAIN>/webhooks/razorpay
PAYMENTS_TEST_MODE=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Limits (defaults shown) ---
MAX_UPLOAD_SIZE_MB=25
RATE_LIMIT_ENABLED=true
DEMO_ENABLED=true
