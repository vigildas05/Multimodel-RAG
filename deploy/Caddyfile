# Reverse proxy with automatic HTTPS (Let's Encrypt) for the API.
# API_DOMAIN comes from deploy/.env.prod (see compose.prod.yml). Certificates are issued
# and renewed automatically; no ACME account email is needed.

{$API_DOMAIN} {
	encode zstd gzip

	# First line of defence; the API enforces its own, tighter per-route limits.
	request_body {
		max_size 30MB
	}

	header -Server

	# Metrics are for a scraper on the private Docker network only, never the internet.
	respond /metrics 404

	reverse_proxy api:8000 {
		health_uri /health
		health_interval 30s
	}

	log {
		output stdout
		format json
	}
}
