# --- Server ---
# development | test | production. Production refuses to start without a strong JWT_SECRET_KEY.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty in local dev for a random per-process key (everyone is signed out on restart).
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_MIN_LENGTH=12
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Admins are created from the command line only:
#   python -m app.cli create-admin --email you@example.com

# --- Database ---
# Local Postgres from docker-compose.yml. For Neon, use its connection string with the
# postgresql+psycopg:// scheme and ?sslmode=require. Apply migrations with `alembic upgrade head`.
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel

# --- LLM security gateway (backend/security) ---
# Heuristic rules + an ML prompt-injection classifier (downloaded on first start, ~740MB).
# A classifier-only detection is scaled by SECURITY_CLASSIFIER_WEIGHT so it can flag but not
# block on its own (the model has confident false positives on some benign text).
SECURITY_ENABLED=true
SECURITY_CLASSIFIER_ENABLED=true
SECURITY_CLASSIFIER_MODEL=protectai/deberta-v3-base-prompt-injection-v2
SECURITY_CLASSIFIER_WEIGHT=0.7
SECURITY_BLOCK_THRESHOLD=0.8
SECURITY_FLAG_THRESHOLD=0.5
SECURITY_QUARANTINE_THRESHOLD=0.75
MAX_QUESTION_CHARS=4000
PII_REDACTION_ENABLED=true

# --- Rate limiting (sliding window in Redis at REDIS_URL; fails open if Redis is down) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_IP_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_IP_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_ACCOUNT_PER_HOUR=20
RATE_LIMIT_REGISTER_PER_IP_PER_HOUR=10
RATE_LIMIT_DEMO_PER_IP_PER_MINUTE=3
RATE_LIMIT_REFRESH_PER_IP_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_USER_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_USER_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_USER_PER_MINUTE=10

# --- Request limits ---
MAX_JSON_BODY_KB=64

# --- Credits ---
CREDIT_COST_QUERY=1
CREDIT_COST_PDF=0
CREDIT_COST_IMAGE=3
CREDIT_COST_AUDIO=5
SIGNUP_BONUS_CREDITS=20
DEMO_BONUS_CREDITS=30
# Operators can adjust balances: python -m app.cli grant-credits --email X --amount 100

# --- Payments: Razorpay TEST MODE only (leave empty to disable payments) ---
# Test keys (rzp_test_...) from the Razorpay dashboard in Test Mode. Live keys, or
# PAYMENTS_TEST_MODE=false, make the app refuse to start: this project never takes real money.
PAYMENTS_TEST_MODE=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Background processing ---
# Uploads are processed by the arq worker: run `arq app.worker.WorkerSettings` from backend/.
# INGEST_MODE=inline processes uploads inside the request instead (no worker needed; slower
# requests, and heavy models load in the API process). Use it only for quick local tries.
REDIS_URL=redis://localhost:6379/0
INGEST_MODE=queue
INGEST_JOB_TIMEOUT_SECONDS=900
WORKER_MAX_JOBS=2

# --- Storage & upload limits ---
# File type is detected from content (magic bytes) and must match the extension.
MAX_UPLOAD_SIZE_MB=25
MAX_DOCUMENTS_PER_WORKSPACE=100
# Enforced by the sandboxed parser in the worker:
MAX_PDF_PAGES=100
MAX_IMAGE_PIXELS=40000000
MAX_AUDIO_SECONDS=1800
# Each parse runs in a separate process, killed after this long (memory cap: Linux only).
PARSE_TIMEOUT_SECONDS=60
PARSE_MEMORY_LIMIT_MB=1536

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=chunks_v2

# --- Chunking (defaults, overridden per-request from the UI's Advanced Retrieval Settings) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Embeddings ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# --- Reranking ---
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu

# --- Retrieval defaults ---
RETRIEVAL_TOP_K_DEFAULT=10
FINAL_CONTEXT_CHUNKS_DEFAULT=4
USE_HYBRID_SEARCH_DEFAULT=true
USE_RERANKING_DEFAULT=true

# --- Generation ---
# LLM_PROVIDER selects the provider implementation from app/services/llm/factory.py.
# Currently supported: "ollama" (default, free, local, no API key).
# "groq" is scaffolded as a proof that swapping providers needs no caller changes —
# see app/services/llm/groq_provider.py before enabling it.
LLM_PROVIDER=ollama
TEMPERATURE_DEFAULT=0.2
TOP_P_DEFAULT=0.9
MAX_OUTPUT_TOKENS_DEFAULT=800

# --- Ollama (used when LLM_PROVIDER=ollama) ---
# Ollama must be installed and running separately: https://ollama.com
# Run: ollama pull llama3.2:3b && ollama pull moondream
# If the backend runs inside Docker on Windows/Mac, use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=moondream

# --- Groq (only used if LLM_PROVIDER=groq; not required for the default setup) ---
# GROQ_API_KEY=

# --- Whisper ---
# base/small are CPU-friendly; upgrade to medium/large-v3 if you have GPU VRAM to spare.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
